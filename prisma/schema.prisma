// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Historical name; stores every application regardless of channel
/// (manual entry for company-site applications as well as synced ones).
model BossContact {
  id               String      @id @default(cuid())
  companyName      String
  jobTitle         String
  source           String      @default("boss_zhipin")
  sourceKey        String      @unique
  jobUrl           String?
  jobDescription   String?
  appliedAt        DateTime?
  stage            String      @default("applied")
  note             String?
  sourceActivityAt DateTime?
  sourceStatusCode Int?
  unchangedSince   DateTime?
  autoRejectedAt   DateTime?
  interviews       Interview[]
  firstSeenAt      DateTime    @default(now())
  lastSeenAt       DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([source])
  @@index([stage])
  @@index([appliedAt])
  @@index([lastSeenAt])
  @@index([sourceActivityAt])
  @@index([autoRejectedAt])
}

/// Applications the user deleted in the app. Sync channels skip these
/// source keys so removed jobs are not re-added on the next sync.
model DismissedApplication {
  sourceKey   String   @id
  companyName String
  jobTitle    String
  dismissedAt DateTime @default(now())
}

model Resume {
  id             String                 @id @default(cuid())
  originalName   String
  storedName     String                 @unique
  filePath       String
  mimeType       String
  fileSize       Int
  isDefault      Boolean                @default(false)
  projects       ResumeProject[]
  projectSources ResumeProjectSource[]
  mockSessions   MockInterviewSession[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([isDefault])
  @@index([createdAt])
}

model ResumeProject {
  id           String                @id @default(cuid())
  resumeId     String?
  resume       Resume?               @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  name         String
  type         String                @default("project")
  organization String?
  description  String?
  startDate    String?
  endDate      String?
  sourceText   String?
  sortOrder    Int                   @default(0)
  /// 出题前自动识别写入、尚未经用户确认；用户编辑过即清空。
  autoExtractedAt DateTime?
  sources      ResumeProjectSource[]
  questions    InterviewQuestion[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([resumeId])
  @@index([type])
  @@index([name])
  @@index([sortOrder])
}

model ResumeProjectSource {
  id              String        @id @default(cuid())
  resumeId        String
  resume          Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeProjectId String
  resumeProject   ResumeProject @relation(fields: [resumeProjectId], references: [id], onDelete: Cascade)
  extractedName   String
  finalName       String
  sourceText      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([resumeId, resumeProjectId, extractedName])
  @@index([resumeId])
  @@index([resumeProjectId])
}

model Interview {
  id              String                     @id @default(cuid())
  kind            String                     @default("real")
  sourceType      String                     @default("real_summary")
  companyName     String
  jobTitle        String
  roleKey         String?
  roleContext     RoleContext?               @relation(fields: [roleKey], references: [key], onDelete: SetNull)
  applicationId   String?
  application     BossContact?               @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  interviewedAt   DateTime?
  scheduledAt     DateTime?
  round           String?
  status          String                     @default("completed")
  note            String?
  questions       InterviewQuestion[]
  mockSession     MockInterviewSession?
  importArtifact  InterviewImportArtifact?
  assessments     InterviewAssessment[]
  observations    AbilityObservation[]
  insightEvidence CandidateInsightEvidence[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([interviewedAt])
  @@index([kind])
  @@index([sourceType])
  @@index([roleKey])
  @@index([applicationId])
  @@index([scheduledAt])
  @@index([status])
  @@index([round])
  @@index([updatedAt])
}

model InterviewQuestion {
  id              String                       @id @default(cuid())
  interviewId     String
  interview       Interview                    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question        String
  answer          String?
  voiceMetricsJson String?
  skippedAt       DateTime?
  parentQuestionId String?
  parentQuestion  InterviewQuestion?          @relation("QuestionFollowUps", fields: [parentQuestionId], references: [id], onDelete: Cascade)
  followUps       InterviewQuestion[]          @relation("QuestionFollowUps")
  category        String                       @default("general")
  resumeProjectId String?
  resumeProject   ResumeProject?               @relation(fields: [resumeProjectId], references: [id], onDelete: SetNull)
  evaluation      InterviewQuestionEvaluation?
  observations    AbilityObservation[]
  insightEvidence CandidateInsightEvidence[]
  sortOrder       Int
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([interviewId, sortOrder])
  @@index([category])
  @@index([resumeProjectId])
}

model MockInterviewSession {
  id                   String    @id @default(cuid())
  interviewId          String    @unique
  interview            Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  resumeId             String?
  resume               Resume?   @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jdOriginalName       String?
  jdTextSnapshot       String
  resumeTextSnapshot   String
  contextSnapshotJson  String
  status               String    @default("generating")
  generationPhase      String?
  generationErrorCode  String?
  generationError      String?
  interactionMode      String    @default("text")
  /// 面试时长（分钟）；题目数量不再是输入，而是面试过程的结果。
  pace                 String    @default("standard")
  /// 备课产物：考察领域、评分表、简历假设、切入问题。
  briefJson            String?
  /// 面试官的工作记忆：已确认 / 存疑 / 失守 / 假设状态。
  memoryJson           String    @default("{}")
  /// 已结束的线程数；仅作展示，真相在 InterviewThread。
  questionCount        Int       @default(0)
  /// 旧分步流程遗留，只读回放用。
  currentQuestionIndex Int       @default(0)
  provider             String
  model                String
  promptVersion        String
  totalScore           Int?
  reportJson           String?
  startedAt            DateTime?
  completedAt          DateTime?
  messages             MockInterviewMessage[]
  threads              InterviewThread[]
  decisions            InterviewTurnDecision[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([resumeId])
  @@index([status])
  @@index([updatedAt])
}

/// 对话式面试的一条消息。候选人消息带 clientId 做幂等。
model MockInterviewMessage {
  id               String               @id @default(cuid())
  sessionId        String
  session          MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientId         String?
  turnIndex        Int
  role             String
  kind             String
  content          String
  threadId         String?
  thread           InterviewThread?     @relation(fields: [threadId], references: [id], onDelete: SetNull)
  toolName         String?
  /// 候选人消息的作答元数据：{ composeMs, chars, voice? }；面试官消息为 null。
  metricsJson      String?
  createdAt        DateTime             @default(now())

  @@unique([sessionId, clientId])
  @@index([sessionId, turnIndex])
}

/// 一段围绕某个考察领域的对话：切入问题 + 追问 + 候选人的全部回答。
/// 关闭时写一条 InterviewQuestion 作为兼容层，评分、复盘、画像照旧。
model InterviewThread {
  id            String               @id @default(cuid())
  sessionId     String
  session       MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  areaId        String
  entryQuestion String
  status        String               @default("active")
  depth         Int                  @default(0)
  rescues       Int                  @default(0)
  clarifies     Int                  @default(0)
  interrupts    Int                  @default(0)
  openedAtTurn  Int
  closedAtTurn  Int?
  note          String?
  questionId    String?              @unique
  messages      MockInterviewMessage[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([sessionId, areaId])
}

model InterviewQuestionEvaluation {
  id                       String               @id @default(cuid())
  interviewQuestionId      String               @unique
  interviewQuestion        InterviewQuestion    @relation(fields: [interviewQuestionId], references: [id], onDelete: Cascade)
  assessmentId             String?
  assessment               InterviewAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  sourceKind               String               @default("profile")
  rubricJson               String               @default("{}")
  expectedSignalsJson      String               @default("[]")
  applicableDimensionsJson String?
  generationMetadataJson   String               @default("{}")
  evaluationStatus         String               @default("pending")
  evaluationError          String?
  dimensionsJson           String?
  score                    Int?
  /// 评分 v2：strengths / weaknesses 带回答原话引用，advice 是练什么；exemplar 是示范回答（只在有短板时生成）。
  strengthsJson            String?
  weaknessesJson           String?
  adviceJson               String?
  exemplarJson             String?
  feedback                 String?
  evaluatedAt              DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([score])
  @@index([assessmentId])
  @@index([evaluationStatus])
}

model RoleContext {
  key                  String      @id
  displayName          String
  normalizedTitle      String      @unique
  targetJobDescription String?
  blueprintJson        String      @default("{}")
  isPinned             Boolean     @default(false)
  interviews           Interview[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model InterviewImportArtifact {
  id               String     @id @default(cuid())
  interviewId      String?    @unique
  interview        Interview? @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sourceType       String
  transcriptText   String
  segmentsJson     String     @default("[]")
  durationSeconds  Float?
  candidateSpeaker String?
  voiceMetricsJson String?
  capabilitiesJson String     @default("{}")
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime   @default(now())

  @@index([expiresAt])
}

model InterviewAssessment {
  id                  String                        @id @default(cuid())
  interviewId         String
  interview           Interview                     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sourceHash          String
  assessmentVersion   String
  promptVersion       String
  status              String                        @default("pending")
  provider            String?
  model               String?
  error               String?
  startedAt           DateTime                      @default(now())
  completedAt         DateTime?
  questionEvaluations InterviewQuestionEvaluation[]
  observations        AbilityObservation[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@unique([interviewId, sourceHash, assessmentVersion])
  @@index([interviewId, status])
  @@index([completedAt])
}

model AbilityObservation {
  id                String                     @id @default(cuid())
  assessmentId      String
  assessment        InterviewAssessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  interviewId       String
  interview         Interview                  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId        String?
  question          InterviewQuestion?         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  dimension         String
  score             Float
  modelConfidence   Float
  evidenceExcerpt   String
  sourceType        String
  sourceWeight      Float
  roleKey           String?
  speechMetricsJson String?
  status            String                     @default("active")
  originalDimension String?
  userCorrectedAt   DateTime?
  insightEvidence   CandidateInsightEvidence[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([assessmentId, questionId, dimension])
  @@index([interviewId, dimension, status])
  @@index([roleKey, dimension])
}

model CandidateProfileState {
  id                String    @id
  status            String    @default("idle")
  revision          Int       @default(0)
  summaryJson       String    @default("{}")
  pendingSince      DateTime?
  dueAt             DateTime?
  lastSourceAt      DateTime?
  lastProcessedAt   DateTime?
  lastRefreshedAt   DateTime?
  needsFullRebuild  Boolean   @default(false)
  phase             String    @default("idle")
  completedCount    Int       @default(0)
  totalCount        Int       @default(0)
  assessmentVersion String    @default("ability-assessment-v2")
  lastError         String?
  leaseToken        String?
  leaseExpiresAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model CandidateInsight {
  id              String                     @id @default(cuid())
  dimension       String
  kind            String
  title           String
  statement       String
  normalizedKey   String
  roleKey         String                     @default("all")
  confidence      Float
  level           Float?
  levelLabel      String                     @default("待积累")
  trend           String                     @default("insufficient")
  confidenceLabel String                     @default("待积累")
  status          String                     @default("tentative")
  isUserLocked    Boolean                    @default(false)
  userEditedAt    DateTime?
  hasConflict     Boolean                    @default(false)
  evidence        CandidateInsightEvidence[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([roleKey, normalizedKey])
  @@index([dimension, status])
  @@index([roleKey, dimension, status])
  @@index([isUserLocked])
}

model CandidateInsightEvidence {
  id                String              @id @default(cuid())
  insightId         String
  insight           CandidateInsight    @relation(fields: [insightId], references: [id], onDelete: Cascade)
  interviewId       String
  interview         Interview           @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId        String?
  question          InterviewQuestion?  @relation(fields: [questionId], references: [id], onDelete: SetNull)
  observationId     String?
  observation       AbilityObservation? @relation(fields: [observationId], references: [id], onDelete: SetNull)
  polarity          String              @default("supports")
  sourceKind        String
  excerpt           String
  weight            Float
  status            String              @default("active")
  originalDimension String?
  userCorrectedAt   DateTime?
  createdAt         DateTime            @default(now())

  @@unique([insightId, observationId])
  @@index([interviewId])
  @@index([questionId])
  @@index([observationId])
}

model CandidateProfileMetric {
  id                 String   @id @default(cuid())
  roleKey            String   @default("all")
  dimension          String
  level              Float?
  levelLabel         String   @default("待积累")
  trend              String   @default("insufficient")
  evidenceConfidence Float    @default(0)
  confidenceLabel    String   @default("待积累")
  interviewCount     Int      @default(0)
  realInterviewCount Int      @default(0)
  evidenceCount      Int      @default(0)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([roleKey, dimension])
  @@index([roleKey])
}

model CandidateProfileSnapshot {
  id                String   @id @default(cuid())
  revision          Int
  roleKey           String   @default("all")
  metricsJson       String
  insightIdsJson    String   @default("[]")
  assessmentVersion String
  createdAt         DateTime @default(now())

  @@unique([revision, roleKey])
  @@index([roleKey, createdAt])
}

model CandidateProfileRun {
  id                String    @id @default(cuid())
  mode              String
  status            String    @default("running")
  fullRebuild       Boolean   @default(false)
  evidenceCount     Int       @default(0)
  phase             String    @default("assessment")
  completedCount    Int       @default(0)
  totalCount        Int       @default(0)
  assessmentVersion String    @default("ability-assessment-v2")
  provider          String?
  model             String?
  promptVersion     String
  error             String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  @@index([status])
  @@index([startedAt])
}

/// 每次模型调用与每次代码裁决落一行，按 runId 串成一次生成的完整链路。
/// payload / output / rawText 供离线回放；网页版无状态，不写这张表。
model AgentRun {
  id            String   @id @default(cuid())
  runId         String
  agent         String
  event         String
  status        String
  provider      String
  model         String
  promptVersion String
  durationMs    Int
  finishReason  String?
  inputTokens   Int?
  outputTokens  Int?
  totalTokens   Int?
  errorKind     String?
  metricsJson   String?
  payloadJson   String?
  outputJson    String?
  rawText       String?
  /// 评测跑出来的记录打标签，与真实使用分开；真实使用为 null。
  tag           String?
  createdAt     DateTime @default(now())

  @@index([runId])
  @@index([agent, createdAt])
  @@index([status, createdAt])
  @@index([tag, createdAt])
}


/// 每回合一条决策记录：模型提了什么、代码用了什么、为什么换、信息量怎么变。trace 页面与评测读它。
model InterviewTurnDecision {
  id              String               @id @default(cuid())
  sessionId       String
  session         MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turnIndex       Int
  runId           String
  proposedAction  String?
  appliedAction   String?
  followUp        String?
  replacedReason  String?
  anchorHit       Boolean?
  memoryPatchJson String?
  evidenceBefore  Float
  evidenceAfter   Float
  skillsLoaded    Int                  @default(0)
  effectsJson     String
  createdAt       DateTime             @default(now())

  @@unique([sessionId, turnIndex])
}
